# AgentPay Mandate — environment for agent/server.
# Local demo needs NONE of this (defaults point at a local anvil).

# Mode: local (default) or testnet
MODE=local

# Local mode: anvil --hardfork shanghai --chain-id 44005
RPC_URL=http://127.0.0.1:8545
CHAIN_ID=44005

# ---- Testnet mode (Aevum, chain 44005) ----
# MODE=testnet
# RPC_URL=https://rpc-test.qday.info
# TOKEN_ADDRESS=0x456569838f1d43009A91ebA4263147Afd7233483
# OWNER_KEY=0x...     # deployer/owner wallet, funded via the QDay Discord faucet
# AGENT_KEY=0x...     # agent signing key (holds no funds, needs no gas)
# RELAYER_KEY=0x...   # relayer wallet, needs a little tQDAY for gas
# NEVER commit real keys. data/keys.json (local demo wallets) is gitignored too.
